PORT=3000

# URL publique de l'app (utilisee pour generer le lien dans le QR code).
# En local: http://localhost:3000 (ou laissez vide, elle est devinee automatiquement).
# En prod sur Vercel: mettez l'URL de votre projet, ex. https://networking-match.vercel.app
BASE_URL=

# Mot de passe pour la page /admin
ADMIN_KEY=changez-moi

# Fournie automatiquement par Vercel quand vous connectez une base "Neon Postgres"
# depuis l'onglet Storage du projet. En local, recuperez-la avec `vercel env pull .env`.
# Ne collez jamais la vraie valeur ici : ce fichier est suivi par git.
DATABASE_URL=

# Fournie automatiquement par Vercel quand vous creez un "Blob store"
# depuis l'onglet Storage du projet. En local, recuperez-la avec `vercel env pull .env`.
# Ne collez jamais la vraie valeur ici : ce fichier est suivi par git.
BLOB_READ_WRITE_TOKEN=
