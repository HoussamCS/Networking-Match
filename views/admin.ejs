<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Admin — Networking Match</title>
  <link rel="stylesheet" href="/style.css">
  <style>.wrap { max-width: 760px; }</style>
</head>
<body>
  <div class="wrap">
    <div class="card">
      <h1>Tableau de bord</h1>
      <p class="lead"><%= people.length %> inscrit(s) · <%= matchCount %> match(s) réalisé(s)</p>

      <div class="stats">
        <% Object.keys(counts).forEach(function(cat) { %>
          <div class="stat">
            <div class="n"><%= counts[cat] %></div>
            <div class="l"><%= categoryLabel[cat] %></div>
          </div>
        <% }) %>
      </div>

      <a class="btn" href="/admin/export.csv?key=<%= key %>">⬇️ Exporter en CSV</a>

      <form method="POST" action="/admin/reset" onsubmit="return confirm('Supprimer TOUS les inscrits, matchs et photos ? Action irréversible.');">
        <input type="hidden" name="key" value="<%= key %>">
        <button type="submit" style="background:#fef2f2;color:#b91c1c;border:2px solid #fecaca;">🗑️ Réinitialiser toutes les données</button>
      </form>

      <table>
        <thead>
          <tr><th></th><th>Nom</th><th>Occupation</th><th>Catégorie</th><th>Inscrit le</th></tr>
        </thead>
        <tbody>
          <% people.forEach(function(p) { %>
            <tr>
              <td>
                <% if (p.photo) { %>
                  <img class="admin-thumb" src="/photo?pathname=<%= encodeURIComponent(p.photo) %>" alt="">
                <% } else { %>
                  <span class="admin-thumb-placeholder"><%= p.nom.trim().charAt(0).toUpperCase() %></span>
                <% } %>
              </td>
              <td><%= p.nom %></td>
              <td><%= p.occupation %></td>
              <td><%= categoryLabel[p.categorie] %></td>
              <td><%= p.created_at %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</body>
</html>
