<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Votre match — Networking Match</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="wrap">
    <div class="card match-result">
      <% if (match) { %>
        <span class="tag"><%= categoryLabel %></span>
        <div class="avatar-circle"><%= match.nom.trim().charAt(0).toUpperCase() %></div>
        <h1><%= match.nom %></h1>
        <p class="lead"><%= match.occupation || '—' %></p>

        <% if (match.email) { %>
          <p class="muted">📧 <a class="plain" href="mailto:<%= match.email %>"><%= match.email %></a></p>
        <% } %>
        <% if (match.telephone) { %>
          <p class="muted">📱 <a class="plain" href="tel:<%= match.telephone %>"><%= match.telephone %></a></p>
        <% } %>

        <form method="POST" action="/match/<%= person.id %>">
          <input type="hidden" name="categorie" value="<%= categorie %>">
          <button type="submit">🔄 Nouveau match (<%= categoryLabel %>)</button>
        </form>
      <% } else { %>
        <h1>Aucun profil disponible</h1>
        <p class="lead">Il n'y a pas encore de <%= categoryLabel.toLowerCase() %> inscrit(e). Réessayez plus tard !</p>
      <% } %>

      <a class="btn btn-outline" href="/match/<%= person.id %>">← Changer de catégorie</a>
    </div>
  </div>
</body>
</html>
