<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Trouver un match — Networking Match</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="wrap">
    <div class="card">
      <span class="tag"><%= categoryLabel %></span>
      <h1>Salut <%= person.nom %> !</h1>
      <h2>Qui voulez-vous rencontrer ?</h2>

      <form method="POST" action="/match/<%= person.id %>">
        <div class="category-grid">
          <% categories.forEach(function(c) { %>
            <button
              type="submit"
              name="categorie"
              value="<%= c.value %>"
              class="category-btn"
              <%= counts[c.value] === 0 ? 'disabled' : '' %>
            >
              <%= c.label %>
              <span class="count"><%= counts[c.value] %> disponible(s)</span>
            </button>
          <% }) %>
        </div>
      </form>
    </div>
  </div>
</body>
</html>
