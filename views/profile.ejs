<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Mon profil — Networking Match</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="wrap">
    <%- include('partials/nav', { active: 'profile' }) %>
    <div class="card">
      <% if (person.photo) { %>
        <img class="profile-photo" src="/photo?pathname=<%= encodeURIComponent(person.photo) %>" alt="Photo de <%= person.nom %>">
      <% } %>
      <span class="tag"><%= categoryLabel %></span>
      <h1>Bienvenue, <%= person.nom %> 👋</h1>
      <p class="lead"><%= person.occupation || 'Profil enregistré.' %></p>

      <div class="qr-box">
        <img src="<%= qrDataUrl %>" alt="QR code de <%= person.nom %>">
        <p class="muted">Montrez ce QR code à quelqu'un pour qu'il vous ajoute à ses matchs, ou allez dans "Scanner" pour scanner le sien.</p>
      </div>
    </div>
  </div>
</body>
</html>
