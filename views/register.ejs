<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Inscription — Networking Match</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="wrap">
    <a class="back-link" href="/">← Accueil</a>
    <div class="card">
      <h1>Inscription</h1>
      <p class="lead">Remplissez vos informations, vous recevrez ensuite votre QR code personnel.</p>

      <% if (error) { %>
        <div class="error"><%= error %></div>
      <% } %>

      <form method="POST" action="/register" enctype="multipart/form-data">
        <input type="hidden" name="next" value="<%= next %>">

        <label for="nom">Nom complet *</label>
        <input type="text" id="nom" name="nom" placeholder="Ex. Sarah El Amrani" required>

        <label for="occupation">Occupation / activité</label>
        <input type="text" id="occupation" name="occupation" placeholder="Ex. Fondatrice de Startup X">

        <label for="categorie">Je suis... *</label>
        <select id="categorie" name="categorie" required>
          <option value="" disabled selected>Choisir une catégorie</option>
          <% categories.forEach(function(c) { %>
            <option value="<%= c.value %>"><%= c.label %></option>
          <% }) %>
        </select>

        <label for="photo">Photo (pour être reconnu·e lors du match)</label>
        <div class="photo-picker">
          <div class="photo-preview" id="photoPreview">📷</div>
          <div class="photo-actions">
            <label for="photo" class="btn btn-secondary photo-btn">Prendre / choisir une photo</label>
            <input type="file" id="photo" name="photo" accept="image/*" class="photo-input">
          </div>
        </div>

        <label for="email">Email (optionnel)</label>
        <input type="email" id="email" name="email" placeholder="vous@exemple.com">

        <label for="telephone">Téléphone (optionnel, pour WhatsApp)</label>
        <div style="display:flex; gap:8px;">
          <select id="indicatif" name="indicatif" style="flex:0 0 130px; padding:12px 8px; border:1px solid var(--border); border-radius:10px; font-size:0.95rem; background:#fafafa;">
            <option value="212" selected>🇲🇦 +212</option>
            <option value="33">🇫🇷 +33</option>
            <option value="34">🇪🇸 +34</option>
            <option value="32">🇧🇪 +32</option>
            <option value="41">🇨🇭 +41</option>
            <option value="49">🇩🇪 +49</option>
            <option value="39">🇮🇹 +39</option>
            <option value="31">🇳🇱 +31</option>
            <option value="351">🇵🇹 +351</option>
            <option value="44">🇬🇧 +44</option>
            <option value="1">🇺🇸 +1</option>
            <option value="216">🇹🇳 +216</option>
            <option value="213">🇩🇿 +213</option>
            <option value="971">🇦🇪 +971</option>
            <option value="966">🇸🇦 +966</option>
            <option value="other">Autre (taper +indicatif)</option>
          </select>
          <input type="tel" id="telephone" name="telephone" placeholder="6 12 34 56 78" style="flex:1;">
        </div>

        <button type="submit">Générer mon QR code</button>
      </form>
    </div>
    <%- include('partials/footer') %>
  </div>

  <script>
    var input = document.getElementById('photo');
    var preview = document.getElementById('photoPreview');
    input.addEventListener('change', function () {
      var file = input.files && input.files[0];
      if (!file) return;
      var reader = new FileReader();
      reader.onload = function (e) {
        preview.style.backgroundImage = 'url(' + e.target.result + ')';
        preview.textContent = '';
      };
      reader.readAsDataURL(file);
    });
  </script>
</body>
</html>
